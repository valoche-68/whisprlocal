# Optional WhisprLocal local-engine settings. No account or cloud provider keys.
# Configure self-hosted endpoints and their optional credentials in the application.
LOCAL_TRANSCRIPTION_PROVIDER=whisper
LOCAL_WHISPER_MODEL=turbo
DICTATION_LANGUAGE=auto
UI_LANGUAGE=en

# Installed GPU packs are selected automatically. Set false to opt out.
# WHISPER_CUDA_ENABLED=false
# WHISPER_VULKAN_ENABLED=false
