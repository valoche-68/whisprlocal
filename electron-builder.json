{
  "appId": "io.github.valoche68.whisprlocal",
  "afterPack": "scripts/afterPack.js",
  "productName": "WhisprLocal",
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/workers/**/*",
    "src/config/**/*",
    "src/constants/**/*",
    "src/locales/**/*",
    "src/hooks/**/*",
    "src/models/**/*",
    "src/services/localReasoningBridge.js",
    "src/services/transcriptionBaseUrl.ts",
    "src/stores/policyRules.ts",
    "src/types/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*",
    "!**/node_modules/electron/**",
    "!**/node_modules/electron-builder/**",
    "!**/node_modules/app-builder-bin/**",
    "!**/node_modules/app-builder-lib/**",
    "!**/node_modules/builder-util/**",
    "!**/node_modules/dmg-builder/**",
    "!**/node_modules/7zip-bin/**",
    "!**/node_modules/typescript/**",
    "!**/node_modules/prettier/**",
    "!**/node_modules/eslint/**",
    "!**/node_modules/eslint-*/**",
    "!**/node_modules/@eslint/**",
    "!**/node_modules/@typescript-eslint/**",
    "!**/node_modules/globals/**",
    "!**/node_modules/vite/**",
    "!**/node_modules/@vitejs/**",
    "!**/node_modules/esbuild/**",
    "!**/node_modules/@esbuild/**",
    "!**/node_modules/rollup/**",
    "!**/node_modules/@rollup/**",
    "!**/node_modules/postcss/**",
    "!**/node_modules/autoprefixer/**",
    "!**/node_modules/tailwindcss/**",
    "!**/node_modules/@tailwindcss/**",
    "!**/node_modules/lightningcss*/**",
    "!**/node_modules/react/**",
    "!**/node_modules/react-dom/**",
    "!**/node_modules/lucide-react/**",
    "!**/node_modules/@radix-ui/**",
    "!**/node_modules/class-variance-authority/**",
    "!**/node_modules/clsx/**",
    "!**/node_modules/tailwind-merge/**",
    "!**/node_modules/tw-animate-css/**",
    "!**/node_modules/react-markdown/**",
    "!**/node_modules/shadcn-ui/**",
    "!**/node_modules/@types/**",
    "!**/node_modules/concurrently/**",
    "!**/node_modules/cross-env/**",
    "!**/node_modules/@electron/notarize/**",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**",
    "!**/node_modules/**/*.ts",
    "!**/node_modules/**/*.map",
    "!**/node_modules/**/CHANGELOG*",
    "!**/node_modules/**/.github/**",
    "src/local/**/*",
    "upstream.json"
  ],
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**/*",
    "**/node_modules/ps-list/**/*",
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/@napi-rs/keyring/**/*",
    "src/workers/**/*"
  ],
  "extraResources": [
    {
      "from": "src/assets",
      "to": "src/assets",
      "filter": [
        "**/*",
        "!fonts/yowza/**"
      ]
    },
    {
      "from": "resources/bin/",
      "to": "bin/",
      "filter": [
        "whisper-cpp-*",
        "whisper-server-*",
        "llama-server-*",
        "sherpa-onnx-*",
        "yt-dlp-*",
        "qdrant-*",
        "macos-audio-tap",
        "macos-globe-listener",
        "macos-fast-paste",
        "macos-mic-listener",
        "macos-calendar-listener",
        "macos-text-monitor",
        "macos-window-bounds",
        "macos-media-remote",
        "MediaRemoteAdapter.framework/**",
        "linux-fast-paste",
        "linux-system-audio-helper",
        "linux-text-monitor",
        "linux-key-listener*",
        "meeting-aec-helper-*",
        "windows-key-listener*",
        "windows-mic-listener*",
        "windows-system-audio-helper*",
        "windows-text-monitor*",
        "windows-fast-paste*",
        "all-MiniLM-L6-v2/**/*",
        "diarization-models/**/*",
        "whisper-vad/**/*",
        "*.dylib",
        "*.dll",
        "*.so*"
      ]
    },
    {
      "from": "scripts/whisprlocal/install.sh",
      "to": "install.sh"
    }
  ],
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "tar.gz",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "src/assets/icon.png",
    "category": "Utility",
    "artifactName": "WhisprLocal-${version}-linux-${arch}.${ext}",
    "maintainer": "valoche-68 <valoche-68@users.noreply.github.com>"
  },
  "deb": {
    "afterInstall": "resources/linux/after-install.sh",
    "afterRemove": "resources/linux/after-remove.sh",
    "depends": [
      "ydotool",
      "libpipewire-0.3-0"
    ],
    "fpm": [
      "--deb-recommends",
      "ydotoold",
      "--deb-suggests",
      "xdotool",
      "--deb-suggests",
      "wtype",
      "--deb-recommends",
      "wl-clipboard",
      "--deb-recommends",
      "xclip",
      "--deb-suggests",
      "xsel"
    ],
    "artifactName": "WhisprLocal-${version}-linux-x64.deb"
  },
  "publish": {
    "provider": "github",
    "owner": "valoche-68",
    "repo": "whisprlocal",
    "private": false,
    "releaseType": "draft"
  },
  "executableName": "whisprlocal",
  "appImage": {
    "artifactName": "WhisprLocal-${version}-linux-x64.AppImage"
  }
}
