{
  "name": "whisprlocal",
  "version": "0.1.0",
  "description": "Independent Linux dictation with local and self-hosted models",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile:globe": "node scripts/build-globe-listener.js",
    "compile:fast-paste": "node scripts/build-macos-fast-paste.js",
    "compile:linuxkeys": "node scripts/build-linux-key-listener.js",
    "compile:text-monitor": "node scripts/build-text-monitor.js",
    "compile:linux-paste": "node scripts/build-linux-fast-paste.js",
    "compile:linux-system-audio": "node scripts/build-linux-system-audio.js",
    "compile:media-remote": "node scripts/build-media-remote.js",
    "compile:mediaremote-adapter": "node scripts/build-mediaremote-adapter.js",
    "compile:mic-listener": "node scripts/build-macos-mic-listener.js",
    "compile:calendar-listener": "node scripts/build-macos-calendar-listener.js",
    "compile:audio-tap": "node scripts/build-macos-audio-tap.js",
    "compile:native": "npm run compile:linuxkeys && npm run compile:linux-paste && npm run compile:linux-system-audio",
    "prestart": "npm run compile:native && npm run download:meeting-aec-helper && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:embedding-model && npm run download:whisper-vad-model",
    "start": "electron .",
    "dev": "concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "predev:main": "npm run compile:native && npm run download:meeting-aec-helper && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:embedding-model && npm run download:whisper-vad-model",
    "dev:main": "cross-env NODE_ENV=development node scripts/run-electron.js --dev",
    "dev:renderer": "cd src && vite",
    "prebuild": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:embedding-model -- --for-build && npm run download:diarization-models -- --output-dir resources/bin/diarization-models && node node_modules/@electron/rebuild/lib/cli.js --force --which-module better-sqlite3",
    "build": "npm run build:renderer && electron-builder --linux --x64",
    "postinstall": "electron-builder install-app-deps",
    "build:renderer": "cd src && vite build",
    "prebuild:linux": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models && node node_modules/@electron/rebuild/lib/cli.js --force --which-module better-sqlite3",
    "build:linux": "npm run build:renderer && electron-builder --linux --x64",
    "build:linux:appimage": "npm run build:renderer && electron-builder --linux AppImage",
    "build:linux:deb": "npm run build:renderer && electron-builder --linux deb",
    "build:linux:tar": "npm run build:renderer && electron-builder --linux tar.gz",
    "prepack": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models && node node_modules/@electron/rebuild/lib/cli.js --force --which-module better-sqlite3",
    "pack": "npm run build:renderer && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "predist": "npm run compile:native && npm run download:whisper-cpp && npm run download:llama-server && npm run download:sherpa-onnx && npm run download:yt-dlp && npm run download:qdrant && npm run download:meeting-aec-helper && npm run download:whisper-vad-model && npm run download:diarization-models -- --output-dir resources/bin/diarization-models && node node_modules/@electron/rebuild/lib/cli.js --force --which-module better-sqlite3",
    "dist": "npm run build:renderer && electron-builder",
    "download:whisper-cpp": "node scripts/download-whisper-cpp.js --current",
    "download:whisper-cpp:all": "node scripts/download-whisper-cpp.js --all",
    "download:llama-server": "node scripts/download-llama-server.js --current",
    "download:llama-server:all": "node scripts/download-llama-server.js --all",
    "download:sherpa-onnx": "node scripts/download-sherpa-onnx.js --current",
    "download:sherpa-onnx:all": "node scripts/download-sherpa-onnx.js --all",
    "download:yt-dlp": "node scripts/download-yt-dlp.js --current",
    "download:yt-dlp:all": "node scripts/download-yt-dlp.js --all",
    "download:nircmd": "node scripts/download-nircmd.js",
    "download:meeting-aec-helper": "node scripts/download-meeting-aec-helper.js --current",
    "download:meeting-aec-helper:all": "node scripts/download-meeting-aec-helper.js --all",
    "download:qdrant": "node scripts/download-qdrant.js --current",
    "download:qdrant:all": "node scripts/download-qdrant.js --all",
    "download:embedding-model": "node scripts/download-minilm.js",
    "download:diarization-models": "node scripts/download-diarization-models.js",
    "download:whisper-vad-model": "node scripts/download-whisper-vad-model.js",
    "format:js": "eslint . --fix && cd src && eslint . --fix && prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format": "npm run format:js",
    "format:check": "eslint . && cd src && eslint . && prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint": "eslint . && cd src && eslint .",
    "test": "node --import tsx --test \"test/**/*.test.js\"",
    "typecheck": "cd src && tsc --noEmit",
    "quality-check": "npm run format:check && npm run typecheck",
    "i18n:check": "node scripts/check-i18n.js",
    "preview": "cd src && vite preview",
    "clean": "node cleanup.js",
    "cli": "node src/local/command.cjs",
    "test:local": "node --test test/local/*.test.cjs"
  },
  "keywords": [
    "dictation",
    "speech-to-text",
    "whisper",
    "whisper.cpp",
    "electron",
    "desktop-app"
  ],
  "author": {
    "name": "WhisprLocal contributors"
  },
  "license": "MIT",
